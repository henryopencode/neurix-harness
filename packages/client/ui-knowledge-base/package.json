{
  "name": "@deepseek-ai/dsh-client-ui-knowledge-base",
  "description": "Manage workspace documents and explore their source-derived knowledge graph.",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryopencode/neurix-harness.git",
    "directory": "packages/client/ui-knowledge-base"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-knowledge-base": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-resources": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "d3-force": "^3.0.0",
    "@types/d3-force": "^3.0.10",
    "@testing-library/react": "^16.3.3",
    "@deepseek-ai/dsh-api-remote-access": "workspace:*"
  }
}
